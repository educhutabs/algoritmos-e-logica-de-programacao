Algoritmo "pares_consecutivos"

Var

   x, soma : inteiro

Inicio

   escreva("Digite um número inteiro: ")
   leia(x)

   enquanto X <> 0 faca

      se x % 2 <> 0 entao
         x <- X + 1
      fimse

      soma <- 5 * X + 20
      escreval("Soma: ", soma)

      escreva("Digite um número inteiro: ")
      leia(x)

   fimenquanto

Fimalgoritmo